{
  "name": "estate-ai",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Local-first real estate measurement, floor plan, 3D and design studio (PWA).",
  "license": "MIT",
  "scripts": {
    "dev": "vite --host",
    "dev:https": "vite --host --mode https",
    "build": "tsc --noEmit -p . && vite build",
    "preview": "vite preview --host",
    "preview:https": "vite preview --host --mode https",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node tests/e2e/run-e2e.mjs",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "idb": "^8.0.4",
    "jspdf": "^4.2.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.32",
    "@types/react-dom": "^18.3.7",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "fake-indexeddb": "^6.2.8",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
